PORT=5050

DB_HOST=localhost
DB_PORT=8889
DB_USER=root
DB_PASSWORD=root
DB_NAME=nawaratrend

# long random value; generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# websites allowed to call the API (comma-separated)
CLIENT_ORIGIN=http://localhost:3000,http://localhost:3001

# ---------- SMS (mobile OTP) ----------
# renflair = live text messages via Renflair (the default in production); log = codes printed to this console (development only)
SMS_PROVIDER=log
# from your Renflair account; keep it here only, never in the database or code
RENFLAIR_API_KEY=
# optional: a separate secret for hashing OTP codes (defaults to JWT_SECRET)
OTP_SECRET=

# ---------- email ----------
# sendmail (default in production) | smtp (SMTP_HOST, SMTP_PORT, SMTP_SECURE=1, SMTP_USER, SMTP_PASS) | log (development)
EMAIL_TRANSPORT=log

# customer sign-in cookies are Secure (https only) in production; set 1 to force it elsewhere
COOKIE_SECURE=
